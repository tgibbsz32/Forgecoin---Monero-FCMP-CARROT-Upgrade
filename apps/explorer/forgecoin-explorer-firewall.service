[Unit]
Description=Allow ForgeCoin explorer HTTP traffic
Before=nginx.service
After=network-pre.target
[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp --dport 80 -j ACCEPT || /usr/sbin/iptables -I INPUT 1 -p tcp --dport 80 -j ACCEPT'
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
