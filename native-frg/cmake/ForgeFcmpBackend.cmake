# Actual pinned FCMP++ Rust backend; consensus wiring is a separate port stage.
option(FORGE_BUILD_FCMP_BACKEND "Build the experimental native FCMP++ proof backend and ABI tests" OFF)
if(FORGE_BUILD_FCMP_BACKEND)
  find_program(FORGE_CARGO cargo REQUIRED)
  find_program(FORGE_RUSTC rustc REQUIRED)
  if(MINGW)
    set(FORGE_RUST_TARGET x86_64-pc-windows-gnu)
    set(FORGE_RUST_SYSTEM_LIBS ws2_32 userenv bcrypt ntdll advapi32)
  elseif(UNIX)
    execute_process(COMMAND "${FORGE_RUSTC}" -vV OUTPUT_VARIABLE rust_version COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCH "host: ([^\n\r]+)" rust_host "${rust_version}")
    set(FORGE_RUST_TARGET "${CMAKE_MATCH_1}")
    set(FORGE_RUST_SYSTEM_LIBS ${CMAKE_DL_LIBS} pthread m)
  else()
    message(FATAL_ERROR "FCMP backend port currently supports native Unix or Windows MinGW; MSVC ABI review is pending")
  endif()
  set(FORGE_FCMP_CARGO_TARGET_DIR "${CMAKE_BINARY_DIR}/fcmp-rust" CACHE PATH "Isolated FCMP Rust build output")
  set(fcmp_rust_source "${CMAKE_SOURCE_DIR}/src/fcmp_pp/fcmp_pp_rust")
  set(fcmp_rust_archive "${FORGE_FCMP_CARGO_TARGET_DIR}/${FORGE_RUST_TARGET}/debug/libfcmp_pp_rust.a")
  add_custom_command(OUTPUT "${fcmp_rust_archive}"
    COMMAND "${CMAKE_COMMAND}" -E env "CARGO_TARGET_DIR=${FORGE_FCMP_CARGO_TARGET_DIR}"
      "${FORGE_CARGO}" build --locked --manifest-path "${fcmp_rust_source}/Cargo.toml" --target "${FORGE_RUST_TARGET}" -j 2
    DEPENDS "${fcmp_rust_source}/Cargo.toml" "${fcmp_rust_source}/Cargo.lock" "${fcmp_rust_source}/src/lib.rs"
    VERBATIM)
  add_custom_target(forge_fcmp_rust DEPENDS "${fcmp_rust_archive}")
  add_library(forge_fcmp_backend STATIC IMPORTED GLOBAL)
  set_target_properties(forge_fcmp_backend PROPERTIES IMPORTED_LOCATION "${fcmp_rust_archive}")
  add_dependencies(forge_fcmp_backend forge_fcmp_rust)
  add_executable(forge_fcmp_backend_ffi "${CMAKE_SOURCE_DIR}/tests/fcmp_port/backend_ffi.c")
  target_include_directories(forge_fcmp_backend_ffi PRIVATE "${fcmp_rust_source}")
  target_link_libraries(forge_fcmp_backend_ffi PRIVATE forge_fcmp_backend ${FORGE_RUST_SYSTEM_LIBS})
  set_property(TARGET forge_fcmp_backend_ffi PROPERTY C_STANDARD 11)
  enable_testing()
  add_test(NAME forge_fcmp_backend_ffi COMMAND forge_fcmp_backend_ffi)
endif()
